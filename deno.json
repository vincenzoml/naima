{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "tasks": {
    "naima": "deno run -A naima/naima.ts",
    "dev": "deno run -A naima/src/cli.ts",
    "typecheck": "deno check naima/naima.ts naima/src/ test/ scripts/",
    "test": "deno test -A test/",
    "docs": "deno run -A naima/src/cli.ts docs --write naima/docs/reference/reference.md",
    "coverage": "deno run -A scripts/coverage.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "verify": "deno task typecheck && deno task lint && deno fmt --check && deno task test && deno run -A naima/src/cli.ts check && deno run -A naima/src/cli.ts docs --check naima/docs/reference/reference.md && deno run -A naima/naima.ts check"
  },
  "fmt": {
    "include": ["naima/naima.ts", "naima/src/", "test/", "scripts/"],
    "lineWidth": 160,
    "indentWidth": 2,
    "semiColons": false
  },
  "lint": {
    "include": ["naima/naima.ts", "naima/src/", "test/", "scripts/"],
    "rules": { "tags": ["recommended"] }
  },
  "lock": false,
  "nodeModulesDir": "none"
}
