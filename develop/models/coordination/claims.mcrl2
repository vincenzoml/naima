% The coordination plugin's claim protocol, as an mCRL2 specification.
% What it models, what it leaves out, and how to check it:
% develop/coordination-model.md.
%
% Two branches, b1 and b2, each with its own worktree, and a trunk. Each
% branch owns one claim file; every tree (a branch's commit, the trunk) holds a
% copy of both files. A branch writes only its own file, on its own working
% copy; it commits it; it enters the trunk by fast-forward only, so it must
% first take in whatever the trunk took since it last did. A branch whose claim
% is on the trunk may be retired (its worktree removed, the branch deleted).
%
% Claims are recombined at read time, as readAcrossBranches does: the claims of
% a branch that still has its worktree are read from that worktree's disk; the
% claims of a retired branch are read from the trunk's copy of its file.
%
% The two protocol rules are switches, true in the protocol. The negative
% experiment sets one to false and the properties fail with a counterexample.

sort Br = struct b1 | b2;                       % the branches, each owning one claim file
     It = struct i1 | i2;                       % the items that can be claimed
     Files = struct files(f1: FSet(It), f2: FSet(It));   % a tree: b1's claim file, b2's claim file
     Refs = struct refs(r1: Files, r2: Files);  % the commit of b1, the commit of b2

map  get: Files # Br -> FSet(It);               % the claim file a branch owns, in a tree
     put: Files # Br # FSet(It) -> Files;
     ref: Refs # Br -> Files;                   % a branch's committed tree
     setref: Refs # Br # Files -> Refs;
     none: Files;
     ff_only: Bool;                             % rule: merges into the trunk are fast-forward only
     own_files_only: Bool;                      % rule: a branch writes no file another branch owns

var  x, y, s: FSet(It);
     p, q, f: Files;
eqn  get(files(x, y), b1) = x;
     get(files(x, y), b2) = y;
     put(files(x, y), b1, s) = files(s, y);
     put(files(x, y), b2, s) = files(x, s);
     ref(refs(p, q), b1) = p;
     ref(refs(p, q), b2) = q;
     setref(refs(p, q), b1, f) = refs(f, q);
     setref(refs(p, q), b2, f) = refs(p, f);
     none = files({}, {});
     ff_only = true;
     own_files_only = true;

act  claim, release: Br # It;                   % naima claim, naima release, on the working copy
     commit: Br;                                % the branch commits its claim file
     merge: Br;                                 % the trunk takes the branch's commit
     sync: Br;                                  % the branch takes the trunk in
     write_other: Br # Br;                      % the branch overwrites another's file: only without own_files_only
     retire: Br;                                % the worktree is removed and the branch deleted
     read: Br # FSet(It);                       % naima claims: what the branch is read to hold

% disk:   each branch's claim file on its own working copy
% branch: each branch's committed tree
% trunk:  the trunk's tree
% fresh:  the branches whose commit contains the trunk (a merge of one is a fast-forward)
% alive:  the branches not retired
proc Repo(disk: Files, branch: Refs, trunk: Files, fresh: FSet(Br), alive: FSet(Br)) =
    sum b: Br, i: It. (b in alive && !(i in get(disk, b))) ->
      claim(b, i) . Repo(disk = put(disk, b, get(disk, b) + {i}))
  + sum b: Br, i: It. (b in alive && i in get(disk, b)) ->
      release(b, i) . Repo(disk = put(disk, b, get(disk, b) - {i}))
  + sum b: Br. (b in alive && get(ref(branch, b), b) != get(disk, b)) ->
      commit(b) . Repo(branch = setref(branch, b, put(ref(branch, b), b, get(disk, b))))
  + sum b: Br. (b in alive && ref(branch, b) != trunk && (b in fresh || !ff_only)) ->
      merge(b) . Repo(trunk = ref(branch, b), fresh = {b})
  + sum b: Br. (b in alive && !(b in fresh)) ->
      sync(b) . Repo(branch = setref(branch, b, put(trunk, b, get(ref(branch, b), b))), fresh = fresh + {b})
  + sum b, o: Br. (!own_files_only && b in alive && o != b && get(ref(branch, b), o) != {}) ->
      write_other(b, o) . Repo(branch = setref(branch, b, put(ref(branch, b), o, {})))
  + sum b: Br. (b in alive && get(disk, b) == get(trunk, b) && get(ref(branch, b), b) == get(trunk, b)) ->
      retire(b) . Repo(alive = alive - {b})
  + sum b: Br. read(b, if(b in alive, get(disk, b), get(trunk, b))) . Repo();

init Repo(none, refs(none, none), none, {b1, b2}, {b1, b2});
