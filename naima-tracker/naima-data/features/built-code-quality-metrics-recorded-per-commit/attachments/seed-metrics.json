{
  "loc": { "preset": "code.loc", "include": ["naima/naima.ts", "naima/src", "scripts"] },
  "test-loc": { "preset": "code.loc", "include": ["test"], "says": "lines of test code" },
  "files": { "preset": "code.files", "include": ["naima/naima.ts", "naima/src", "scripts"] },
  "functions": { "preset": "code.functions", "include": ["naima/naima.ts", "naima/src", "scripts"] },
  "function-size": { "preset": "code.function-size", "include": ["naima/naima.ts", "naima/src", "scripts"] },
  "function-size-max": { "preset": "code.function-size-max", "include": ["naima/naima.ts", "naima/src", "scripts"] },
  "complexity": { "preset": "code.complexity", "include": ["naima/naima.ts", "naima/src", "scripts"] },
  "complexity-max": { "preset": "code.complexity-max", "include": ["naima/naima.ts", "naima/src", "scripts"] },
  "duplication": { "preset": "code.duplication", "include": ["naima/naima.ts", "naima/src", "scripts"] },
  "todos": { "preset": "code.todos", "include": ["naima/naima.ts", "naima/src", "scripts", "test"] },
  "dependencies": { "preset": "code.dependencies", "atMost": 0 },
  "lint": { "preset": "deno.lint", "atMost": 0 },
  "type-errors": { "preset": "deno.type-errors", "run": ["deno", "task", "typecheck"], "atMost": 0 },
  "tests": { "preset": "deno.tests", "run": ["deno", "task", "test"] },
  "test-time": { "preset": "deno.test-time", "run": ["deno", "task", "test"] },
  "coverage": { "preset": "deno.coverage", "run": ["deno", "task", "coverage"] }
}
