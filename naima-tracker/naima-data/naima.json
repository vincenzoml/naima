{
  "format": 2,
  "formats": {
    "gates": 2
  },
  "source": "https://github.com/vincenzoml/naima.git",
  "commit": "7ea88935c7029d760b5c6e10b52b9aa23769f67b",
  "plugins": {
    "gates": {
      "options": {
        "gates": {
          "first-public": {
            "title": "First public release",
            "says": "The repository opens to the public: licence chosen, Naima tracking itself through its own lock, the agent flows written.",
            "holdsOn": "code"
          },
          "paper-submission": {
            "title": "Naima paper submitted",
            "says": "Every pre-submission checklist line of the paper's README is done before the paper deadline.",
            "due": "2026-10-28"
          },
          "release-1.1": {
            "title": "Release 1.1",
            "says": "Naima shines on every metric it records, and the owner's remaining read-throughs and UI checks are done.",
            "version": "1.1",
            "holdsOn": "code"
          }
        }
      }
    },
    "metrics": {
      "options": {
        "metrics": {
          "loc": {
            "preset": "code.loc",
            "include": [
              "naima/naima.ts",
              "naima/src",
              "scripts"
            ]
          },
          "test-loc": {
            "preset": "code.loc",
            "include": [
              "test"
            ],
            "says": "lines of test code"
          },
          "files": {
            "preset": "code.files",
            "include": [
              "naima/naima.ts",
              "naima/src",
              "scripts"
            ]
          },
          "functions": {
            "preset": "code.functions",
            "include": [
              "naima/naima.ts",
              "naima/src",
              "scripts"
            ]
          },
          "function-size": {
            "preset": "code.function-size",
            "include": [
              "naima/naima.ts",
              "naima/src",
              "scripts"
            ]
          },
          "function-size-max": {
            "preset": "code.function-size-max",
            "include": [
              "naima/naima.ts",
              "naima/src",
              "scripts"
            ]
          },
          "complexity": {
            "preset": "code.complexity",
            "include": [
              "naima/naima.ts",
              "naima/src",
              "scripts"
            ]
          },
          "complexity-max": {
            "preset": "code.complexity-max",
            "include": [
              "naima/naima.ts",
              "naima/src",
              "scripts"
            ]
          },
          "duplication": {
            "preset": "code.duplication",
            "include": [
              "naima/naima.ts",
              "naima/src",
              "scripts"
            ]
          },
          "todos": {
            "preset": "code.todos",
            "include": [
              "naima/naima.ts",
              "naima/src",
              "scripts",
              "test"
            ]
          },
          "dependencies": {
            "preset": "code.dependencies",
            "atMost": 0
          },
          "lint": {
            "preset": "deno.lint",
            "atMost": 0
          },
          "type-errors": {
            "preset": "deno.type-errors",
            "run": [
              "deno",
              "task",
              "typecheck"
            ],
            "atMost": 0
          },
          "tests": {
            "preset": "deno.tests",
            "run": [
              "deno",
              "task",
              "test"
            ]
          },
          "test-time": {
            "preset": "deno.test-time",
            "run": [
              "deno",
              "task",
              "test"
            ]
          },
          "coverage": {
            "preset": "deno.coverage",
            "run": [
              "deno",
              "task",
              "coverage"
            ]
          }
        }
      }
    },
    "verifier-mcrl2": {}
  }
}
